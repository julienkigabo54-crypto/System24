# Copy this file to ".env" and fill in your own values. NEVER commit ".env".

# MongoDB Atlas: Atlas dashboard -> Connect -> Drivers -> copy the connection string
# and replace <username> and <password> (URL-encode special characters in the password).
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
DB_NAME=intelligent_inventory

# For local MongoDB instead:
# MONGO_URI=mongodb://localhost:27017
